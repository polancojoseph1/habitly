# Local Codex default is backend/habitly.db when DATABASE_URL is unset.
# Optional PostgreSQL URL for a developer-managed database:
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/habitly
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Frontend settings. Leave NEXT_PUBLIC_API_URL blank to enter the API URL in Settings.
NEXT_PUBLIC_API_URL=
# Next.js server-side proxy destination for local Docker development.
HABITLY_API_INTERNAL_URL=http://127.0.0.1:8000
