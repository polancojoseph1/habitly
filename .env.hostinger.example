# Copy to an untracked .env file on the VPS. Replace every placeholder there.
# Use a long random alphanumeric password so it can safely appear in DATABASE_URL.
POSTGRES_DB=habitly
POSTGRES_USER=habitly
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_SECRET
DATABASE_URL=postgresql+psycopg://habitly:REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_SECRET@db:5432/habitly

# The frontend will only bind this port to VPS loopback. The existing reverse proxy
# must be inspected before choosing a port or routing the public domain to it.
HABITLY_WEB_PORT=3100
CORS_ORIGINS=https://REPLACE_WITH_YOUR_DOMAIN
